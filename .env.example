# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL="postgresql://starapi:change-me@localhost:5432/starapi?schema=public"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="replace-with-a-random-value"
API_KEY_PEPPER="replace-with-a-random-value"
INSTALL_TOKEN="replace-with-a-different-random-value"
INTERNAL_GATEWAY_SECRET="replace-with-another-random-value"
CONFIG_ENCRYPTION_KEY="optional-32-byte-base64-or-64-character-hex-value"
SESSION_COOKIE_SECURE="false"
API_PUBLIC_HOST="localhost"
API_PUBLIC_URL="http://localhost:3000/api"
LOCAL_UPSTREAM_HOSTS="host.docker.internal"
API_ASSET_STORAGE_PATH=".data/api-assets"
MEDIA_MAX_API_GB="100"
MEDIA_MAX_FILE_GB="2"
MEDIA_MAX_ARCHIVE_GB="2"
MEDIA_MAX_ARCHIVE_EXPANDED_GB="20"
# Optional fallback for networks that cannot reach Prisma's default engine CDN.
PRISMA_ENGINES_MIRROR=""
