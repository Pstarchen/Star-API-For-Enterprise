# Application release. App, migrator and PHP runner must always use the same version.
STAR_API_VERSION=0.1.16
STAR_API_APP_IMAGE=ghcr.io/pstarchen/star-api-app
STAR_API_MIGRATOR_IMAGE=ghcr.io/pstarchen/star-api-migrator
STAR_API_PHP_RUNNER_IMAGE=ghcr.io/pstarchen/star-api-php-runner
# cn prefers digest-verified domestic mirrors; global prefers official GHCR.
STAR_API_UPDATE_REGION=auto
STAR_API_IMAGE_PROXIES=ghcr.1ms.run,ghcr.chenby.cn,ghcr.nju.edu.cn
# Increase this value when the server has a slow registry connection (60-7200 seconds).
STAR_API_IMAGE_PULL_TIMEOUT=1800

# Host-local updates are enabled automatically by production:install when running as root with systemd.
# STAR_API_UPDATE_STATE_DIR=/opt/Star-API-For-Enterprise/.star-api-update
# Optional independent version feed. JSON: {"latestVersion":"X.Y.Z"}
# STAR_API_UPDATE_FEED_URL=https://updates.example.com/star-api/stable.json
# STAR_API_UPDATE_LATEST_VERSION=0.1.16

# Deployment secrets are generated once in the starapi-secrets volume.

# App listens on every host interface. Restrict public access with the firewall when using a reverse proxy.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=18081

# Use the website host directly. Public APIs are served under /api.
API_PUBLIC_HOST=example.com
API_PUBLIC_URL=https://example.com
SESSION_COOKIE_SECURE=true

LOCAL_UPSTREAM_HOSTS=host.docker.internal
MEDIA_MAX_API_GB=100

# Infrastructure images are upgraded separately from Star-API.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# Optional compatibility fallback: platform-admin updates through GitHub Actions.
# Store a fine-grained token in a root-only file and mount it read-only into the app container.
# The token only needs Actions workflow dispatch/read access for this repository.
# STAR_API_GITHUB_TOKEN_FILE=/run/star-api-secrets/GITHUB_ACTIONS_TOKEN
# STAR_API_GITHUB_REPOSITORY=Pstarchen/Star-API-For-Enterprise
# STAR_API_GITHUB_DEPLOY_WORKFLOW=deploy-production.yml
# STAR_API_GITHUB_DEPLOY_REF=main
