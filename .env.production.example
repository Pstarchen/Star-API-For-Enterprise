# Application release. App, migrator and PHP runner must always use the same version.
STAR_API_VERSION=0.1.0
STAR_API_APP_IMAGE=ghcr.io/pstarchen/star-api-app
STAR_API_MIGRATOR_IMAGE=ghcr.io/pstarchen/star-api-migrator
STAR_API_PHP_RUNNER_IMAGE=ghcr.io/pstarchen/star-api-php-runner

# Generate every value independently with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-value
API_KEY_PEPPER=replace-with-a-different-long-random-value
SESSION_SECRET=replace-with-another-long-random-value
INSTALL_TOKEN=replace-with-a-fourth-long-random-value
INTERNAL_GATEWAY_SECRET=replace-with-a-fifth-long-random-value
CONFIG_ENCRYPTION_KEY=replace-with-a-sixth-long-random-value

# External reverse proxy forwards to this loopback listener.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=18081

# Use the website host directly. Public APIs are served under /api.
API_PUBLIC_HOST=example.com
API_PUBLIC_URL=https://example.com
SESSION_COOKIE_SECURE=true

LOCAL_UPSTREAM_HOSTS=host.docker.internal
MEDIA_MAX_API_GB=100

# Infrastructure images are upgraded separately from Star-API.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
