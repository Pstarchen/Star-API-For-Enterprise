# Copy this file to .env before running Docker Compose.
# Deployment secrets are generated once in the starapi-secrets volume.
SESSION_COOKIE_SECURE=true

# Main website domain. Public APIs use this domain under /api by default.
# For an IP-only smoke test use http://SERVER_IP and set SESSION_COOKIE_SECURE=false.
SITE_ADDRESS=example.com
API_PUBLIC_HOST=example.com
API_PUBLIC_URL=https://example.com
LOCAL_UPSTREAM_HOSTS=host.docker.internal
MEDIA_MAX_API_GB=100
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=18081
HTTP_PORT=80
HTTPS_PORT=443

# Optional: override these only when the configured Docker Hub mirror is unavailable.
# NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
# POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:16-alpine
# REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7-alpine
# CADDY_IMAGE=m.daocloud.io/docker.io/library/caddy:2-alpine
# ALPINE_IMAGE=m.daocloud.io/docker.io/library/alpine:3.20
# PRISMA_ENGINES_MIRROR=https://npmmirror.com/mirrors/prisma
