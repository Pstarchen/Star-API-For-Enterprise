# Copy this file to .env before running Docker Compose.
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-value
API_KEY_PEPPER=replace-with-a-different-long-random-value
SESSION_SECRET=replace-with-another-long-random-value
INSTALL_TOKEN=replace-with-a-fourth-long-random-value
SESSION_COOKIE_SECURE=true

# Domain for automatic HTTPS, for example api.example.com.
# For an IP-only smoke test use http://SERVER_IP and set SESSION_COOKIE_SECURE=false.
SITE_ADDRESS=api.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Optional: override these only when the configured Docker Hub mirror is unavailable.
# NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
# POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:16-alpine
# REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7-alpine
# CADDY_IMAGE=m.daocloud.io/docker.io/library/caddy:2-alpine
