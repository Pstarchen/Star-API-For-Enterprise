generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberRole {
  OWNER
  ADMIN
  DEVELOPER
  FINANCE
  AUDITOR
}

enum ApiStatus {
  DRAFT
  REVIEW
  GRAY
  PUBLISHED
  DEPRECATED
  OFFLINE
}

enum ApiVisibility {
  PUBLIC
  PRIVATE
  GRAY
  INTERNAL
}

enum ApiUpstreamType {
  PUBLIC_API
  SERVER_LOCAL
  TUNNEL
  CONTENT
  PHP_PACKAGE
  BUILTIN
}

enum ApiRewriteMode {
  PASSTHROUGH
  PREFIX
  EXACT
}

enum ApiHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

enum ApiParameterLocation {
  PATH
  QUERY
  BODY
}

enum ApiAuditDecision {
  SUBMITTED
  APPROVED
  REJECTED
}

enum BillingMode {
  FREE
  PER_REQUEST
}

enum AppEnvironment {
  TEST
  PRODUCTION
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum AccountType {
  PERSONAL
  ENTERPRISE
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentChannel {
  ALIPAY
  WECHAT
  BANK_TRANSFER
  CODE_PAY
  EPAY
}

enum PaymentProviderHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  REFUNDED
}

enum PaymentOrderType {
  INVOICE
  RECHARGE
}

enum WalletEntryType {
  RECHARGE
  REFUND
  ADMIN_RECHARGE
  ADMIN_REFUND
  API_USAGE
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Tenant {
  id                String             @id @default(cuid())
  name              String
  type              AccountType        @default(ENTERPRISE)
  creditCode        String?            @unique
  status            TenantStatus       @default(PENDING)
  plan              String             @default("basic")
  notificationEmail String?
  timezone          String             @default("Asia/Shanghai")
  quotaAlerts       Boolean            @default(true)
  balanceAlerts     Boolean            @default(true)
  balance           Decimal            @default(0) @db.Decimal(14, 6)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       Membership[]
  apps              Application[]
  invoices          Invoice[]
  payments          PaymentOrder[]
  auditLogs         AuditLog[]
  providers         Provider[]
  apiAccessGrants   ApiAccessGrant[]
  walletEntries     WalletEntry[]
  emailActionTokens EmailActionToken[]
  emailDeliveries   EmailDelivery[]

  @@index([status, createdAt])
}

model User {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  name                      String
  accountType               AccountType              @default(PERSONAL)
  platformRole              PlatformRole             @default(USER)
  status                    UserStatus               @default(ACTIVE)
  passwordHash              String?
  emailVerifiedAt           DateTime?
  emailVerificationRequired Boolean                  @default(false)
  mfaEnabled                Boolean                  @default(false)
  lastLoginAt               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  memberships               Membership[]
  sessions                  Session[]
  oauthAccounts             OAuthAccount[]
  emailVerificationTokens   EmailVerificationToken[]
  emailActionTokens         EmailActionToken[]
  auditLogs                 AuditLog[]               @relation("AuditActor")
  apiAudits                 ApiAudit[]               @relation("ApiAuditReviewer")
  walletActions             WalletEntry[]            @relation("WalletActor")

  @@index([platformRole, status])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  username          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OAuthState {
  id           String   @id @default(cuid())
  provider     String
  tokenHash    String   @unique
  redirectPath String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([provider, expiresAt])
}

model OAuthPendingLogin {
  id                 String   @id @default(cuid())
  provider           String
  providerAccountId String
  username           String?
  redirectPath       String
  tokenHash          String   @unique
  email              String?
  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailActionToken {
  id          String    @id @default(cuid())
  purpose     String
  userId      String?
  tenantId    String?
  tokenHash   String    @unique
  targetEmail String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([purpose, userId, expiresAt])
  @@index([purpose, tenantId, expiresAt])
  @@index([expiresAt])
}

model EmailDelivery {
  id             String              @id @default(cuid())
  tenantId       String
  eventId        String
  dedupeKey      String              @unique
  recipientEmail String
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(1)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthThrottle {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformAsset {
  key       String   @id
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationSetting {
  key             String   @id
  enabled         Boolean  @default(false)
  publicConfig    Json     @default("{}")
  secretEncrypted Bytes?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Membership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      MemberRole
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Provider {
  id            String       @id @default(cuid())
  ownerTenantId String?
  name          String
  legalName     String
  verifiedAt    DateTime?
  contactEmail  String
  createdAt     DateTime     @default(now())
  ownerTenant   Tenant?      @relation(fields: [ownerTenantId], references: [id], onDelete: SetNull)
  products      ApiProduct[]

  @@index([ownerTenantId])
}

model ApiCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  description String       @default("")
  sortOrder   Int          @default(0)
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    ApiProduct[]

  @@index([enabled, sortOrder])
}

model ApiProduct {
  id               String           @id @default(cuid())
  providerId       String
  categoryId       String
  slug             String           @unique
  name             String
  shortName        String           @default("API")
  description      String
  color            String           @default("#08785d")
  tags             String[]
  featured         Boolean          @default(false)
  status           ApiStatus        @default(DRAFT)
  visibility       ApiVisibility    @default(PUBLIC)
  sla              Decimal          @db.Decimal(6, 3)
  internalHandler  String?
  executionConfig  Json             @default("{}")
  billingMode      BillingMode      @default(FREE)
  unitPrice        Decimal          @default(0) @db.Decimal(12, 6)
  freeQuotaMonthly BigInt           @default(0)
  defaultQpsLimit  Int              @default(10)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  provider         Provider         @relation(fields: [providerId], references: [id])
  category         ApiCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  upstream         ApiUpstream?
  versions         ApiVersion[]
  assets           ApiAsset[]
  audits           ApiAudit[]
  accessGrants     ApiAccessGrant[]
  subscriptions    Subscription[]
  requestLogs      RequestLog[]

  @@index([status, categoryId])
  @@index([providerId])
}

model ApiAsset {
  id         String     @id @default(cuid())
  productId  String
  kind       String
  name       String
  groupKey   String     @default("")
  mimeType   String
  data       Bytes
  storageKey String?    @unique
  size       BigInt
  createdAt  DateTime   @default(now())
  product    ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind, createdAt])
  @@index([productId, kind, groupKey])
}

model ApiVersion {
  id          String     @id @default(cuid())
  productId   String
  version     String
  basePath    String
  changelog   String?
  publishedAt DateTime?
  product     ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  endpoints   Endpoint[]

  @@unique([productId, version])
}

model Endpoint {
  id                 String                 @id @default(cuid())
  versionId          String
  methods            String[]               @default(["GET"])
  path               String
  publicHost         String
  publicPath         String
  routeVersion       String
  requestFormat      String                 @default("JSON")
  responseFormats    String[]               @default(["JSON"])
  responseExample    Json?
  summary            String
  schema             Json
  corsEnabled        Boolean                @default(false)
  forceHttps         Boolean                @default(true)
  ipAllowlist        String[]
  ipDenylist         String[]
  dailyLimit         BigInt                 @default(0)
  requestLogging     Boolean                @default(true)
  version            ApiVersion             @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestLogs        RequestLog[]
  parameters         ApiParameter[]
  responseParameters ApiResponseParameter[]
  responseRules      ApiResponseRule[]
  testCases          ApiTestCase[]
  usageCounters      ApiUsageCounter[]
  directLinks        DirectLink[]

  @@index([versionId, path])
  @@index([publicHost, publicPath, routeVersion])
  @@index([publicHost, publicPath])
}

model ApiUpstream {
  id                    String            @id @default(cuid())
  productId             String            @unique
  type                  ApiUpstreamType
  rewriteMode           ApiRewriteMode    @default(PASSTHROUGH)
  upstreamPrefix        String            @default("")
  healthPath            String            @default("/health")
  healthStatus          ApiHealthStatus   @default(UNKNOWN)
  timeoutMs             Int               @default(10000)
  offlineOnFailure      Boolean           @default(true)
  authType              String            @default("NONE")
  secretConfigEncrypted Bytes?
  allowPrivateNetwork   Boolean           @default(false)
  lastHealthCheckAt     DateTime?
  lastHealthError       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  product               ApiProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  nodes                 ApiUpstreamNode[]
}

model ApiUpstreamNode {
  id            String          @id @default(cuid())
  upstreamId    String
  name          String
  baseUrl       String
  weight        Int             @default(100)
  enabled       Boolean         @default(true)
  healthStatus  ApiHealthStatus @default(UNKNOWN)
  failureCount  Int             @default(0)
  lastCheckedAt DateTime?
  lastError     String?
  upstream      ApiUpstream     @relation(fields: [upstreamId], references: [id], onDelete: Cascade)

  @@unique([upstreamId, baseUrl])
  @@index([upstreamId, enabled, healthStatus])
}

model ApiParameter {
  id           String               @id @default(cuid())
  endpointId   String
  location     ApiParameterLocation
  name         String
  upstreamName String?
  required     Boolean              @default(false)
  dataType     String               @default("string")
  description  String               @default("")
  defaultValue String?
  validation   Json                 @default("{}")
  sensitive    Boolean              @default(false)
  endpoint     Endpoint             @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, location, name])
}

model ApiResponseParameter {
  id          String   @id @default(cuid())
  endpointId  String
  name        String
  dataType    String   @default("string")
  description String   @default("")
  sortOrder   Int      @default(0)
  endpoint    Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, name])
  @@index([endpointId, sortOrder])
}

model ApiResponseRule {
  id           String   @id @default(cuid())
  endpointId   String
  statusCode   Int
  gatewayCode  String?
  template     Json?
  maskedFields String[]
  endpoint     Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, statusCode])
}

model ApiAccessGrant {
  id        String     @id @default(cuid())
  productId String
  tenantId  String
  createdAt DateTime   @default(now())
  product   ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, tenantId])
}

model ApiAudit {
  id         String           @id @default(cuid())
  productId  String
  reviewerId String?
  decision   ApiAuditDecision
  note       String?
  createdAt  DateTime         @default(now())
  product    ApiProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer   User?            @relation("ApiAuditReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
}

model ApiTestCase {
  id         String   @id @default(cuid())
  endpointId String
  name       String
  request    Json
  expected   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, updatedAt(sort: Desc)])
}

model Application {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  environment   AppEnvironment
  status        String            @default("active")
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  subscriptions Subscription[]
  requestLogs   RequestLog[]
  webhooks      WebhookEndpoint[]

  @@index([tenantId, environment])
}

model ApiKey {
  id          String       @id @default(cuid())
  appId       String
  name        String
  prefix      String
  secretHash  String       @unique
  scopes      String[]
  status      KeyStatus    @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  app         Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  requestLogs RequestLog[]

  @@index([appId, status])
  @@index([prefix])
}

model Subscription {
  id            String             @id @default(cuid())
  appId         String
  productId     String
  status        SubscriptionStatus @default(ACTIVE)
  quotaMonthly  BigInt
  qpsLimit      Int
  unitPrice     Decimal            @db.Decimal(12, 6)
  createdAt     DateTime           @default(now())
  app           Application        @relation(fields: [appId], references: [id], onDelete: Cascade)
  product       ApiProduct         @relation(fields: [productId], references: [id])
  usageCounters ApiUsageCounter[]
  directLinks   DirectLink[]

  @@unique([appId, productId])
}

model DirectLink {
  id                String       @id @default(cuid())
  subscriptionId    String
  endpointId        String
  name              String
  prefix            String
  tokenHash         String       @unique
  tokenEncrypted    Bytes
  defaultParameters Json         @default("{}")
  status            KeyStatus    @default(ACTIVE)
  expiresAt         DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime     @default(now())
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  endpoint          Endpoint     @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  requestLogs       RequestLog[]

  @@index([subscriptionId, status])
  @@index([endpointId])
  @@index([prefix])
}

model ApiUsageCounter {
  id             String       @id
  subscriptionId String
  endpointId     String?
  scope          String
  period         String
  used           BigInt       @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  endpoint       Endpoint?    @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, scope, period])
  @@index([endpointId, scope, period])
}

model RequestLog {
  id            String       @id
  appId         String
  apiKeyId      String?
  directLinkId  String?
  productId     String?
  endpointId    String?
  method        String       @default("GET")
  path          String       @default("/")
  statusCode    Int
  latencyMs     Int
  region        String
  billableUnits BigInt       @default(0)
  amount        Decimal      @default(0) @db.Decimal(14, 6)
  responseBytes BigInt       @default(0)
  errorCode     String?
  billed        Boolean      @default(false)
  occurredAt    DateTime     @default(now())
  app           Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  apiKey        ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  directLink    DirectLink?  @relation(fields: [directLinkId], references: [id], onDelete: SetNull)
  product       ApiProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  endpoint      Endpoint?    @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  walletEntry   WalletEntry?

  @@index([appId, occurredAt(sort: Desc)])
  @@index([productId, occurredAt(sort: Desc)])
  @@index([apiKeyId, occurredAt(sort: Desc)])
  @@index([directLinkId, occurredAt(sort: Desc)])
  @@index([statusCode, occurredAt(sort: Desc)])
}

model PaymentOrder {
  id                   String             @id @default(cuid())
  orderNo              String             @unique
  tenantId             String
  invoiceId            String?
  paymentProviderId    String?
  orderType            PaymentOrderType   @default(INVOICE)
  channel              PaymentChannel
  status               PaymentOrderStatus @default(PENDING)
  amount               Decimal            @db.Decimal(14, 2)
  subject              String
  providerNameSnapshot String?
  paymentType          String?
  externalTradeNo      String?
  paymentUrl           String?
  paymentQrCode        String?
  paymentScheme        String?
  paidAt               DateTime?
  expiresAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice              Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentProvider      PaymentProvider?   @relation(fields: [paymentProviderId], references: [id], onDelete: Restrict)
  walletEntries        WalletEntry[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([invoiceId, createdAt(sort: Desc)])
  @@index([paymentProviderId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model PaymentProvider {
  id                   String                      @id @default(cuid())
  name                 String
  gatewayUrl           String
  merchantPid          String
  merchantKeyEncrypted Bytes
  paymentTypes         String[]
  protocolProfile      String                      @default("GENERIC_EPAY")
  submissionMode       String                      @default("REDIRECT")
  feeRate              Decimal                     @default(0) @db.Decimal(7, 4)
  minAmount            Decimal                     @default(0.01) @db.Decimal(14, 2)
  maxAmount            Decimal                     @default(100000000) @db.Decimal(14, 2)
  sortOrder            Int                         @default(0)
  enabled              Boolean                     @default(false)
  description          String?
  healthStatus         PaymentProviderHealthStatus @default(UNKNOWN)
  lastTestedAt         DateTime?
  lastTestMessage      String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  orders               PaymentOrder[]

  @@index([enabled, sortOrder, createdAt])
  @@index([healthStatus, lastTestedAt])
}

model WalletEntry {
  id             String          @id @default(cuid())
  tenantId       String
  paymentOrderId String?         @unique
  requestLogId   String?         @unique
  actorId        String?
  type           WalletEntryType
  delta          Decimal         @db.Decimal(14, 6)
  balanceAfter   Decimal         @db.Decimal(14, 6)
  reason         String
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  paymentOrder   PaymentOrder?   @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  requestLog     RequestLog?     @relation(fields: [requestLogId], references: [id], onDelete: SetNull)
  actor          User?           @relation("WalletActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model Invoice {
  id       String         @id @default(cuid())
  tenantId String
  period   String
  amount   Decimal        @db.Decimal(14, 2)
  status   InvoiceStatus  @default(DRAFT)
  issuedAt DateTime?
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  payments PaymentOrder[]

  @@unique([tenantId, period])
}

model WebhookEndpoint {
  id              String      @id @default(cuid())
  appId           String
  name            String
  url             String
  secretHash      String
  secretEncrypted Bytes?
  events          String[]
  enabled         Boolean     @default(true)
  createdAt       DateTime    @default(now())
  app             Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, enabled])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  occurredAt DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
}
