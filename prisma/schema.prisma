generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberRole {
  OWNER
  ADMIN
  DEVELOPER
  FINANCE
  AUDITOR
}

enum ApiStatus {
  DRAFT
  REVIEW
  GRAY
  PUBLISHED
  DEPRECATED
  OFFLINE
}

enum ApiVisibility {
  PUBLIC
  PRIVATE
  GRAY
  INTERNAL
}

enum ApiUpstreamType {
  PUBLIC_API
  SERVER_LOCAL
  TUNNEL
  CONTENT
  PHP_PACKAGE
  BUILTIN
}

enum ApiRewriteMode {
  PASSTHROUGH
  PREFIX
}

enum ApiHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

enum ApiParameterLocation {
  PATH
  QUERY
  BODY
}

enum ApiAuditDecision {
  SUBMITTED
  APPROVED
  REJECTED
}

enum BillingMode {
  FREE
  PER_REQUEST
}

enum AppEnvironment {
  TEST
  PRODUCTION
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum AccountType {
  PERSONAL
  ENTERPRISE
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentChannel {
  ALIPAY
  WECHAT
  BANK_TRANSFER
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  REFUNDED
}

model Tenant {
  id                String           @id @default(cuid())
  name              String
  type              AccountType      @default(ENTERPRISE)
  creditCode        String?          @unique
  status            TenantStatus     @default(PENDING)
  plan              String           @default("basic")
  notificationEmail String?
  timezone          String           @default("Asia/Shanghai")
  quotaAlerts       Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  memberships       Membership[]
  apps              Application[]
  invoices          Invoice[]
  payments          PaymentOrder[]
  auditLogs         AuditLog[]
  providers         Provider[]
  apiAccessGrants   ApiAccessGrant[]

  @@index([status, createdAt])
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  accountType     AccountType    @default(PERSONAL)
  platformRole    PlatformRole   @default(USER)
  status          UserStatus     @default(ACTIVE)
  passwordHash    String?
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean        @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  memberships     Membership[]
  sessions        Session[]
  oauthAccounts   OAuthAccount[]
  auditLogs       AuditLog[]     @relation("AuditActor")
  apiAudits       ApiAudit[]     @relation("ApiAuditReviewer")

  @@index([platformRole, status])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  username          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OAuthState {
  id           String   @id @default(cuid())
  provider     String
  tokenHash    String   @unique
  redirectPath String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([provider, expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthThrottle {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformAsset {
  key       String   @id
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationSetting {
  key             String   @id
  enabled         Boolean  @default(false)
  publicConfig    Json     @default("{}")
  secretEncrypted Bytes?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Membership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      MemberRole
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Provider {
  id            String       @id @default(cuid())
  ownerTenantId String?
  name          String
  legalName     String
  verifiedAt    DateTime?
  contactEmail  String
  createdAt     DateTime     @default(now())
  ownerTenant   Tenant?      @relation(fields: [ownerTenantId], references: [id], onDelete: SetNull)
  products      ApiProduct[]

  @@index([ownerTenantId])
}

model ApiCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  description String       @default("")
  sortOrder   Int          @default(0)
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    ApiProduct[]

  @@index([enabled, sortOrder])
}

model ApiProduct {
  id               String           @id @default(cuid())
  providerId       String
  categoryId       String
  slug             String           @unique
  name             String
  shortName        String           @default("API")
  description      String
  color            String           @default("#08785d")
  tags             String[]
  featured         Boolean          @default(false)
  status           ApiStatus        @default(DRAFT)
  visibility       ApiVisibility    @default(PUBLIC)
  sla              Decimal          @db.Decimal(6, 3)
  internalHandler  String?
  executionConfig  Json             @default("{}")
  billingMode      BillingMode      @default(FREE)
  unitPrice        Decimal          @default(0) @db.Decimal(12, 6)
  freeQuotaMonthly BigInt           @default(0)
  defaultQpsLimit  Int              @default(10)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  provider         Provider         @relation(fields: [providerId], references: [id])
  category         ApiCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  upstream         ApiUpstream?
  versions         ApiVersion[]
  assets           ApiAsset[]
  audits           ApiAudit[]
  accessGrants     ApiAccessGrant[]
  subscriptions    Subscription[]
  requestLogs      RequestLog[]

  @@index([status, categoryId])
  @@index([providerId])
}

model ApiAsset {
  id        String     @id @default(cuid())
  productId String
  kind      String
  name      String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime   @default(now())
  product   ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind, createdAt])
}

model ApiVersion {
  id          String     @id @default(cuid())
  productId   String
  version     String
  basePath    String
  changelog   String?
  publishedAt DateTime?
  product     ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  endpoints   Endpoint[]

  @@unique([productId, version])
}

model Endpoint {
  id             String            @id @default(cuid())
  versionId      String
  method         String
  path           String
  publicHost     String
  publicPath     String
  routeVersion   String
  requestFormat  String            @default("JSON")
  summary        String
  schema         Json
  corsEnabled    Boolean           @default(false)
  forceHttps     Boolean           @default(true)
  ipAllowlist    String[]
  ipDenylist     String[]
  dailyLimit     BigInt            @default(0)
  requestLogging Boolean           @default(true)
  version        ApiVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestLogs    RequestLog[]
  parameters     ApiParameter[]
  responseRules  ApiResponseRule[]
  testCases      ApiTestCase[]

  @@unique([versionId, method, path])
  @@unique([publicHost, publicPath, routeVersion, method])
  @@index([publicHost, publicPath])
}

model ApiUpstream {
  id                    String            @id @default(cuid())
  productId             String            @unique
  type                  ApiUpstreamType
  rewriteMode           ApiRewriteMode    @default(PASSTHROUGH)
  upstreamPrefix        String            @default("")
  healthPath            String            @default("/health")
  healthStatus          ApiHealthStatus   @default(UNKNOWN)
  timeoutMs             Int               @default(10000)
  offlineOnFailure      Boolean           @default(true)
  authType              String            @default("NONE")
  secretConfigEncrypted Bytes?
  allowPrivateNetwork   Boolean           @default(false)
  lastHealthCheckAt     DateTime?
  lastHealthError       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  product               ApiProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  nodes                 ApiUpstreamNode[]
}

model ApiUpstreamNode {
  id            String          @id @default(cuid())
  upstreamId    String
  name          String
  baseUrl       String
  weight        Int             @default(100)
  enabled       Boolean         @default(true)
  healthStatus  ApiHealthStatus @default(UNKNOWN)
  failureCount  Int             @default(0)
  lastCheckedAt DateTime?
  lastError     String?
  upstream      ApiUpstream     @relation(fields: [upstreamId], references: [id], onDelete: Cascade)

  @@unique([upstreamId, baseUrl])
  @@index([upstreamId, enabled, healthStatus])
}

model ApiParameter {
  id           String               @id @default(cuid())
  endpointId   String
  location     ApiParameterLocation
  name         String
  upstreamName String?
  required     Boolean              @default(false)
  dataType     String               @default("string")
  validation   Json                 @default("{}")
  sensitive    Boolean              @default(false)
  endpoint     Endpoint             @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, location, name])
}

model ApiResponseRule {
  id           String   @id @default(cuid())
  endpointId   String
  statusCode   Int
  gatewayCode  String?
  template     Json?
  maskedFields String[]
  endpoint     Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, statusCode])
}

model ApiAccessGrant {
  id        String     @id @default(cuid())
  productId String
  tenantId  String
  createdAt DateTime   @default(now())
  product   ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, tenantId])
}

model ApiAudit {
  id         String           @id @default(cuid())
  productId  String
  reviewerId String?
  decision   ApiAuditDecision
  note       String?
  createdAt  DateTime         @default(now())
  product    ApiProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer   User?            @relation("ApiAuditReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
}

model ApiTestCase {
  id         String   @id @default(cuid())
  endpointId String
  name       String
  request    Json
  expected   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, updatedAt(sort: Desc)])
}

model Application {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  environment   AppEnvironment
  status        String            @default("active")
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  subscriptions Subscription[]
  requestLogs   RequestLog[]
  webhooks      WebhookEndpoint[]

  @@index([tenantId, environment])
}

model ApiKey {
  id          String       @id @default(cuid())
  appId       String
  name        String
  prefix      String
  secretHash  String       @unique
  scopes      String[]
  status      KeyStatus    @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  app         Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  requestLogs RequestLog[]

  @@index([appId, status])
  @@index([prefix])
}

model Subscription {
  id           String             @id @default(cuid())
  appId        String
  productId    String
  status       SubscriptionStatus @default(ACTIVE)
  quotaMonthly BigInt
  qpsLimit     Int
  unitPrice    Decimal            @db.Decimal(12, 6)
  createdAt    DateTime           @default(now())
  app          Application        @relation(fields: [appId], references: [id], onDelete: Cascade)
  product      ApiProduct         @relation(fields: [productId], references: [id])

  @@unique([appId, productId])
}

model RequestLog {
  id            String      @id
  appId         String
  apiKeyId      String?
  productId     String?
  endpointId    String?
  method        String      @default("GET")
  path          String      @default("/")
  statusCode    Int
  latencyMs     Int
  region        String
  billableUnits BigInt      @default(0)
  amount        Decimal     @default(0) @db.Decimal(14, 6)
  responseBytes Int         @default(0)
  errorCode     String?
  billed        Boolean     @default(false)
  occurredAt    DateTime    @default(now())
  app           Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  apiKey        ApiKey?     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  product       ApiProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  endpoint      Endpoint?   @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([appId, occurredAt(sort: Desc)])
  @@index([productId, occurredAt(sort: Desc)])
  @@index([apiKeyId, occurredAt(sort: Desc)])
  @@index([statusCode, occurredAt(sort: Desc)])
}

model PaymentOrder {
  id              String             @id @default(cuid())
  orderNo         String             @unique
  tenantId        String
  invoiceId       String?
  channel         PaymentChannel
  status          PaymentOrderStatus @default(PENDING)
  amount          Decimal            @db.Decimal(14, 2)
  subject         String
  externalTradeNo String?
  paymentUrl      String?
  paidAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([invoiceId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model Invoice {
  id       String         @id @default(cuid())
  tenantId String
  period   String
  amount   Decimal        @db.Decimal(14, 2)
  status   InvoiceStatus  @default(DRAFT)
  issuedAt DateTime?
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  payments PaymentOrder[]

  @@unique([tenantId, period])
}

model WebhookEndpoint {
  id              String      @id @default(cuid())
  appId           String
  name            String
  url             String
  secretHash      String
  secretEncrypted Bytes?
  events          String[]
  enabled         Boolean     @default(true)
  createdAt       DateTime    @default(now())
  app             Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, enabled])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  occurredAt DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
}
