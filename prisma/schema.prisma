generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberRole {
  OWNER
  ADMIN
  DEVELOPER
  FINANCE
  AUDITOR
}

enum ApiStatus {
  DRAFT
  REVIEW
  PUBLISHED
  DEPRECATED
  OFFLINE
}

enum ApiExecutionMode {
  INTERNAL
  EXTERNAL
}

enum BillingMode {
  FREE
  PER_REQUEST
}

enum AppEnvironment {
  TEST
  PRODUCTION
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum AccountType {
  PERSONAL
  ENTERPRISE
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentChannel {
  ALIPAY
  WECHAT
  BANK_TRANSFER
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  REFUNDED
}

model Tenant {
  id                String         @id @default(cuid())
  name              String
  type              AccountType    @default(ENTERPRISE)
  creditCode        String?        @unique
  status            TenantStatus   @default(PENDING)
  plan              String         @default("basic")
  notificationEmail String?
  timezone          String         @default("Asia/Shanghai")
  quotaAlerts       Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  memberships       Membership[]
  apps              Application[]
  invoices          Invoice[]
  payments          PaymentOrder[]
  auditLogs         AuditLog[]

  @@index([status, createdAt])
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  accountType     AccountType    @default(PERSONAL)
  platformRole    PlatformRole   @default(USER)
  status          UserStatus     @default(ACTIVE)
  passwordHash    String?
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean        @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  memberships     Membership[]
  sessions        Session[]
  oauthAccounts   OAuthAccount[]
  auditLogs       AuditLog[]     @relation("AuditActor")

  @@index([platformRole, status])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  username          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OAuthState {
  id           String   @id @default(cuid())
  provider     String
  tokenHash    String   @unique
  redirectPath String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([provider, expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthThrottle {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformAsset {
  key       String   @id
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationSetting {
  key             String   @id
  enabled         Boolean  @default(false)
  publicConfig    Json     @default("{}")
  secretEncrypted Bytes?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Membership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      MemberRole
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Provider {
  id           String       @id @default(cuid())
  name         String
  legalName    String
  verifiedAt   DateTime?
  contactEmail String
  createdAt    DateTime     @default(now())
  products     ApiProduct[]
}

model ApiProduct {
  id                    String           @id @default(cuid())
  providerId            String
  slug                  String           @unique
  name                  String
  shortName             String           @default("API")
  description           String
  category              String
  color                 String           @default("#08785d")
  tags                  String[]
  featured              Boolean          @default(false)
  status                ApiStatus        @default(DRAFT)
  sla                   Decimal          @db.Decimal(6, 3)
  executionMode         ApiExecutionMode @default(EXTERNAL)
  internalHandler       String?
  upstreamBaseUrl       String?
  upstreamAuthType      String?
  executionConfig       Json             @default("{}")
  secretConfigEncrypted Bytes?
  timeoutMs             Int              @default(10000)
  billingMode           BillingMode      @default(FREE)
  unitPrice             Decimal          @default(0) @db.Decimal(12, 6)
  freeQuotaMonthly      BigInt           @default(0)
  defaultQpsLimit       Int              @default(10)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  provider              Provider         @relation(fields: [providerId], references: [id])
  versions              ApiVersion[]
  subscriptions         Subscription[]
  requestLogs           RequestLog[]

  @@index([status, category])
  @@index([providerId])
}

model ApiVersion {
  id          String     @id @default(cuid())
  productId   String
  version     String
  basePath    String
  changelog   String?
  publishedAt DateTime?
  product     ApiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  endpoints   Endpoint[]

  @@unique([productId, version])
}

model Endpoint {
  id          String       @id @default(cuid())
  versionId   String
  method      String
  path        String
  summary     String
  schema      Json
  version     ApiVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestLogs RequestLog[]

  @@unique([versionId, method, path])
}

model Application {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  environment   AppEnvironment
  status        String            @default("active")
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  subscriptions Subscription[]
  requestLogs   RequestLog[]
  webhooks      WebhookEndpoint[]

  @@index([tenantId, environment])
}

model ApiKey {
  id          String       @id @default(cuid())
  appId       String
  name        String
  prefix      String
  secretHash  String       @unique
  scopes      String[]
  status      KeyStatus    @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  app         Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  requestLogs RequestLog[]

  @@index([appId, status])
  @@index([prefix])
}

model Subscription {
  id           String             @id @default(cuid())
  appId        String
  productId    String
  status       SubscriptionStatus @default(ACTIVE)
  quotaMonthly BigInt
  qpsLimit     Int
  unitPrice    Decimal            @db.Decimal(12, 6)
  createdAt    DateTime           @default(now())
  app          Application        @relation(fields: [appId], references: [id], onDelete: Cascade)
  product      ApiProduct         @relation(fields: [productId], references: [id])

  @@unique([appId, productId])
}

model RequestLog {
  id            String      @id
  appId         String
  apiKeyId      String?
  productId     String?
  endpointId    String?
  method        String      @default("GET")
  path          String      @default("/")
  statusCode    Int
  latencyMs     Int
  region        String
  billableUnits BigInt      @default(0)
  amount        Decimal     @default(0) @db.Decimal(14, 6)
  responseBytes Int         @default(0)
  errorCode     String?
  billed        Boolean     @default(false)
  occurredAt    DateTime    @default(now())
  app           Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  apiKey        ApiKey?     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  product       ApiProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  endpoint      Endpoint?   @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([appId, occurredAt(sort: Desc)])
  @@index([productId, occurredAt(sort: Desc)])
  @@index([apiKeyId, occurredAt(sort: Desc)])
  @@index([statusCode, occurredAt(sort: Desc)])
}

model PaymentOrder {
  id              String             @id @default(cuid())
  orderNo         String             @unique
  tenantId        String
  invoiceId       String?
  channel         PaymentChannel
  status          PaymentOrderStatus @default(PENDING)
  amount          Decimal            @db.Decimal(14, 2)
  subject         String
  externalTradeNo String?
  paymentUrl      String?
  paidAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([invoiceId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model Invoice {
  id       String         @id @default(cuid())
  tenantId String
  period   String
  amount   Decimal        @db.Decimal(14, 2)
  status   InvoiceStatus  @default(DRAFT)
  issuedAt DateTime?
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  payments PaymentOrder[]

  @@unique([tenantId, period])
}

model WebhookEndpoint {
  id              String      @id @default(cuid())
  appId           String
  name            String
  url             String
  secretHash      String
  secretEncrypted Bytes?
  events          String[]
  enabled         Boolean     @default(true)
  createdAt       DateTime    @default(now())
  app             Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, enabled])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  occurredAt DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
}
